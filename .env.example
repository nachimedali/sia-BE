# Copy to .env for local development. Never commit .env.
# Generate the two keys with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- core ---
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
FIELD_ENCRYPTION_KEY=change-me

# Ports match deploy/docker-compose.yml, which offsets off the defaults so the
# stack coexists with a Postgres/Redis already running on the machine.
DATABASE_URL=postgres://occs:occs@127.0.0.1:5433/occs
REDIS_URL=redis://127.0.0.1:6380/0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- storage (Phase 4) ---
# AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=occs
# AWS_SECRET_ACCESS_KEY=occs-dev-secret
# AWS_STORAGE_BUCKET_NAME=occs-media

# --- billing (Phase 3) ---
# Unset, the fake gateway is used (design.md A8) and checkout returns a stub
# URL. Set all three to run against Stripe test mode.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # from `stripe listen`
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# USE_FAKE_BILLING=False

# --- providers (Phase 7/9/10/14) ---
# LLM_PROVIDER=
# LLM_API_KEY=
# IMAGE_PROVIDER_API_KEY=
# VIDEO_PROVIDER_API_KEY=
# PUBLISHING_PROVIDER=
# PUBLISHING_PROVIDER_API_KEY=
# TREND_VENDOR_API_KEY=

