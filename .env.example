# ComposeVision — backend environment.
#
# Copy to `.env` for local development. **Never commit `.env`.**
#
# ─────────────────────────────────────────────────────────────────────────────
# WHAT DOES *NOT* BELONG IN THIS FILE
# ─────────────────────────────────────────────────────────────────────────────
# No price. No quota. No limit. No feature flag that a customer pays for.
#
# Every commercial number lives in the database and is edited in the Django
# admin (BUILD-PLAN Part 7 rule 10). Plan prices, credit allowances, workspace
# caps, trial post quotas, analytics horizons, comment-capture cadence and the
# per-plan feature map are rows in `billing_plan` and `billing_pack`, seeded by
# `manage.py seed_plans` / `seed_packs` and changed by an operator without a
# deploy. Putting one here would mean a price change needs a release, and two
# environments could quietly disagree about what a customer bought.
#
# This file holds *wiring only*: where things are, which vendor answers, and
# which secret opens the door.
#
# Generate the two required keys with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ─────────────────────────────────────────────────────────────────────────────
# THE FAKE RULE
# ─────────────────────────────────────────────────────────────────────────────
# Every external dependency sits behind a port with a deterministic fake, and
# each `USE_FAKE_*` defaults to ON when its vendor key is absent. So a fresh
# checkout runs end to end with none of the keys below set — that is deliberate
# (Part 7 rule 6), and it is why almost everything here is commented out.
#
# `config/settings/prod.py` pins every `USE_FAKE_*` to False and reads
# ZERNIO_API_KEY without a fallback, so a production deploy that lost a key
# fails at boot rather than silently fabricating data (Part 7 rule 17).


# ═════════════════════════════════════════════════════════════════════════════
# CORE — required, no defaults
# ═════════════════════════════════════════════════════════════════════════════
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Fernet key for encrypted model fields. Rotating it makes existing ciphertext
# unreadable, so treat it as permanent once any data exists.
FIELD_ENCRYPTION_KEY=change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ports match deploy/docker-compose.yml, which offsets off the defaults so the
# stack coexists with a Postgres/Redis already running on the machine.
DATABASE_URL=postgres://occs:occs@127.0.0.1:5433/occs
REDIS_URL=redis://127.0.0.1:6380/0

# Where the browser reaches the app. Used in emails, reminder links and invite
# links, so a wrong value produces links that 404 for the recipient.
# SITE_URL=http://localhost:3000

# Optional. Both default to REDIS_URL; split them only to move Celery or the
# rate-limit buckets onto their own instance.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# RATELIMIT_REDIS_URL=
# DB_CONN_MAX_AGE=60
# LOG_LEVEL=INFO

# Session lifetimes. Not commercial — these are security posture, and shortening
# the access token only costs a refresh round-trip.
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=14


# ═════════════════════════════════════════════════════════════════════════════
# STORAGE — S3 / MinIO
# ═════════════════════════════════════════════════════════════════════════════
# Unset ⇒ USE_FAKE_STORAGE, which keeps media on the local filesystem.
# AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=occs
# AWS_SECRET_ACCESS_KEY=occs-dev-secret
# AWS_STORAGE_BUCKET_NAME=occs-media
# USE_FAKE_STORAGE=False

# Where a stored media path becomes a URL the publishing provider can fetch.
# Defaults to SITE_URL; S3 already returns absolute URLs and passes through.
# PUBLIC_MEDIA_BASE_URL=


# ═════════════════════════════════════════════════════════════════════════════
# BILLING — Stripe
# ═════════════════════════════════════════════════════════════════════════════
# Unset ⇒ USE_FAKE_BILLING, and checkout returns a stub URL (design.md A8).
# Set all three to run against Stripe test mode.
#
# NOTE: prices are *not* set here. A plan's price lives on its row and its
# Stripe price id is a column on that row — `stripe_price_id_monthly` /
# `stripe_price_id_annual`, edited in admin. One subscription per organization,
# quantity = workspace count (BUILD-PLAN P0-17).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # from `stripe listen`
# USE_FAKE_BILLING=False


# ═════════════════════════════════════════════════════════════════════════════
# AI PROVIDERS — text, image, video, embeddings
# ═════════════════════════════════════════════════════════════════════════════
# Unset ⇒ USE_FAKE_AI_PROVIDERS. Model names are here rather than in admin
# because they are vendor wiring, not price: what a generation *costs the
# customer* is a `GenerationCost` row.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_DEFAULT_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=30

# IMAGE_PROVIDER=nanobanana
# IMAGE_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# IMAGE_PROVIDER_API_KEY=
# IMAGE_PROVIDER_MODEL=gemini-3.1-flash-image

# No vendor is chosen yet (C-11 / P0-04). Empty means video generation reports
# "no provider configured" rather than falling back to the fake.
# VIDEO_PROVIDER_API_KEY=

# Used by trend clustering (design.md §8.4).
# EMBEDDING_MODEL=text-embedding-3-small

# USE_FAKE_AI_PROVIDERS=False


# ═════════════════════════════════════════════════════════════════════════════
# TRENDS — corpus harvesting
# ═════════════════════════════════════════════════════════════════════════════
# Unset ⇒ USE_FAKE_TREND_VENDORS. Which vendor answers for a given source is a
# `TrendSource.vendor` row, so a dead vendor is a row edit rather than a deploy.
# TREND_VENDOR_BASE_URL=https://trends.p.rapidapi.com
# TREND_VENDOR_API_KEY=
# TREND_VENDOR_TIMEOUT_SECONDS=20
# YOUTUBE_API_KEY=
# REDDIT_USER_AGENT=occs-trends/1.0
# USE_FAKE_TREND_VENDORS=False


# ═════════════════════════════════════════════════════════════════════════════
# PUBLISHING & MEASUREMENT — Zernio
# ═════════════════════════════════════════════════════════════════════════════
# One vendor, two structurally separate ports (BUILD-PLAN P0-28): publishing
# sends data out, measurement pulls it in, and neither carries the other's
# methods. One key today because it is one vendor today.
#
# Unset ⇒ USE_FAKE_PLATFORM_ADAPTER, which also selects the fake metrics
# provider. Rows it produces are stamped `source=FAKE` and excluded from every
# statistic by the queryset, so a fake can never become insight (P0-37).
# ZERNIO_BASE_URL=https://zernio.com/api
# ZERNIO_API_KEY=
# ZERNIO_TIMEOUT_SECONDS=30
# USE_FAKE_PLATFORM_ADAPTER=False

# HMAC secret for the `comment.received` webhook (P0-35). Empty means the
# endpoint refuses every delivery — the right default, since an unconfigured
# webhook that accepted anything would be an open write path into the audience
# tables. The capture *cadence* each plan gets is a plan row, not this.
# ZERNIO_WEBHOOK_SECRET=


# ═════════════════════════════════════════════════════════════════════════════
# MEDIA EDITING — crop & trim (BUILD-PLAN P1-12)
# ═════════════════════════════════════════════════════════════════════════════
# Two ports, and they are deliberately asymmetric. Image editing runs on
# Pillow, already a dependency, so cropping needs no vendor and no key and is
# available in every deployment. Trimming needs a codec — a system dependency
# Part 7 rule 6 says a fresh checkout must not require — so it resolves to
# nothing until a backend is named here, and the service answers 422 rather
# than a fake quietly producing a clip nobody rendered.
#
# Neither editor mutates anything: an edit produces a NEW MediaAsset carrying
# `derived_from`, because the original is immutable by design.
# VIDEO_EDITOR_BACKEND=
# USE_FAKE_MEDIA_EDITOR=False

# ═════════════════════════════════════════════════════════════════════════════
# EMAIL
# ═════════════════════════════════════════════════════════════════════════════
# Unset in dev ⇒ the fake mail sender collects into an in-memory outbox.
# Required without a fallback in production.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@example.com


# ═════════════════════════════════════════════════════════════════════════════
# PRODUCTION ONLY
# ═════════════════════════════════════════════════════════════════════════════
# Read by config/settings/prod.py. Harmless to leave unset in dev.
# SENTRY_DSN=
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
