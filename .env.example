# ComposeVision — backend environment.
#
# Copy to `.env` for local development. **Never commit `.env`.**
#
# ─────────────────────────────────────────────────────────────────────────────
# WHAT DOES *NOT* BELONG IN THIS FILE
# ─────────────────────────────────────────────────────────────────────────────
# No price. No quota. No limit. No feature flag that a customer pays for.
#
# Every commercial number lives in the database and is edited in the Django
# admin (BUILD-PLAN Part 7 rule 10). Plan prices, credit allowances, workspace
# caps, trial post quotas, analytics horizons, comment-capture cadence and the
# per-plan feature map are rows in `billing_plan` and `billing_pack`, seeded by
# `manage.py seed_plans` / `seed_packs` and changed by an operator without a
# deploy. Putting one here would mean a price change needs a release, and two
# environments could quietly disagree about what a customer bought.
#
# This file holds *wiring only*: where things are, which vendor answers, and
# which secret opens the door.
#
# Generate the two required keys with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ─────────────────────────────────────────────────────────────────────────────
# THE FAKE RULE
# ─────────────────────────────────────────────────────────────────────────────
# Every external dependency sits behind a port with a deterministic fake, and
# each `USE_FAKE_*` defaults to ON when its vendor key is absent. So a fresh
# checkout runs end to end with none of the keys below set — that is deliberate
# (Part 7 rule 6), and it is why almost everything here is commented out.
#
# `config/settings/prod.py` pins every `USE_FAKE_*` to False and reads
# ZERNIO_API_KEY without a fallback, so a production deploy that lost a key
# fails at boot rather than silently fabricating data (Part 7 rule 17).


# ═════════════════════════════════════════════════════════════════════════════
# CORE — required, no defaults
# ═════════════════════════════════════════════════════════════════════════════
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Fernet key for encrypted model fields. Rotating it makes existing ciphertext
# unreadable, so treat it as permanent once any data exists.
FIELD_ENCRYPTION_KEY=change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ports match deploy/docker-compose.yml, which offsets off the defaults so the
# stack coexists with a Postgres/Redis already running on the machine.
DATABASE_URL=postgres://occs:occs@127.0.0.1:5433/occs
REDIS_URL=redis://127.0.0.1:6380/0

# Where the browser reaches the app. Used in emails, reminder links and invite
# links, so a wrong value produces links that 404 for the recipient.
# SITE_URL=http://localhost:3000

# Optional. Both default to REDIS_URL; split them only to move Celery or the
# rate-limit buckets onto their own instance.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# RATELIMIT_REDIS_URL=
# DB_CONN_MAX_AGE=60
# LOG_LEVEL=INFO

# Session lifetimes. Not commercial — these are security posture, and shortening
# the access token only costs a refresh round-trip.
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=14


# ═════════════════════════════════════════════════════════════════════════════
# STORAGE — S3 / MinIO
# ═════════════════════════════════════════════════════════════════════════════
# Unset ⇒ USE_FAKE_STORAGE, which keeps media on the local filesystem.
# AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=occs
# AWS_SECRET_ACCESS_KEY=occs-dev-secret
# AWS_STORAGE_BUCKET_NAME=occs-media
# USE_FAKE_STORAGE=False

# Where a stored media path becomes a URL the publishing provider can fetch.
# Defaults to SITE_URL; S3 already returns absolute URLs and passes through.
# PUBLIC_MEDIA_BASE_URL=


# ═════════════════════════════════════════════════════════════════════════════
# BILLING — Stripe
# ═════════════════════════════════════════════════════════════════════════════
# Unset ⇒ USE_FAKE_BILLING, and checkout returns a stub URL (design.md A8).
# Set all three to run against Stripe test mode.
#
# NOTE: prices are *not* set here. A plan's price lives on its row and its
# Stripe price id is a column on that row — `stripe_price_id_monthly` /
# `stripe_price_id_annual`, edited in admin. One subscription per organization,
# quantity = workspace count (BUILD-PLAN P0-17).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # from `stripe listen`
# USE_FAKE_BILLING=False

# ═════════════════════════════════════════════════════════════════════════════
# REPORTING — PDF export (P6-05)
# ═════════════════════════════════════════════════════════════════════════════
# No PDF engine ships yet: the real one needs a headless browser or a
# typesetting library, which is a system dependency a fresh checkout must not
# require. Defaults on, so every report path runs end to end with the fake
# renderer (deliberately JSON, so a broken pipeline cannot masquerade as a
# working one). Turning it off without wiring an engine raises loudly rather
# than emitting a blank document.
# USE_FAKE_REPORT_RENDERER=False

# Cloudflare Turnstile on register, login, password reset and token pages
# (`common.captcha`). Empty = the fake passes every token, and check --deploy
# warns (common.W012). The site key goes in the frontend's env.
# TURNSTILE_SECRET_KEY=
# USE_FAKE_CAPTCHA=

# ═════════════════════════════════════════════════════════════════════════════
# AI PROVIDERS — text, image, video, embeddings
# ═════════════════════════════════════════════════════════════════════════════
# Each vendor has its own fake switch, on until that vendor's key is set: the
# NVIDIA key alone makes text real (page scanning, Studio brief rephrasing,
# captions, digests) while image and video stay on their fakes.
#
# WHICH MODEL each task uses, per package, is chosen in Django admin
# (AI → Model routes), seeded by `ai/0021` from `ai/route_seed.py`. The
# `*_DEFAULT_MODEL` / `*_PROVIDER_MODEL` values below are only the fallback
# when a task has no route. A route names its provider; it is used only while
# the matching `*_PROVIDER` below points at that provider. What a generation
# *costs the customer* is a `GenerationCost` row or a video length row.
# LLM_PROVIDER=nvidia
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_API_KEY=
# LLM_API_KEY=                             # same key under a vendor-neutral name; wins if both set
# LLM_DEFAULT_MODEL=meta/muse-glimmer-30b
# LLM_TIMEOUT_SECONDS=30
# The website import runs in a worker; reasoning models need more than 30 s.
# LLM_BRAND_IMPORT_TIMEOUT_SECONDS=120
# The gateway's per-account request budget, shared by every worker and brand
# (NVIDIA hosted: about 40 a minute). 0 turns the shared bucket off. A call
# waits up to MAX_WAIT for room, and a vendor 429 is retried RETRIES times.
# LLM_RATE_LIMIT_PER_MINUTE=40
# LLM_RATE_LIMIT_MAX_WAIT_SECONDS=30
# LLM_RATE_LIMIT_RETRIES=2

# IMAGE_PROVIDER=nanobanana
# IMAGE_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# IMAGE_PROVIDER_API_KEY=
# IMAGE_PROVIDER_MODEL=gemini-nano-banana-2.1

# Video runs on OpenRouter's video API (pricing.audit.md §5); the model per
# task and package is a route in admin. Empty key means video generation
# reports "no provider configured" rather than falling back to the fake.
# Deliberately separate from OPENROUTER_API_KEY: setting this key is what makes
# renders real, and each one is billed.
# VIDEO_PROVIDER=openrouter
# VIDEO_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
# VIDEO_PROVIDER_API_KEY=
# VIDEO_DEFAULT_MODEL=x-ai/grok-imagine-video-1.5-lite
# A render is polled every INTERVAL seconds, for at most TIMEOUT seconds.
# VIDEO_POLL_INTERVAL_SECONDS=10
# VIDEO_POLL_TIMEOUT_SECONDS=600

# S17 look-alike check for invented avatars (AWS Rekognition celebrity
# recognition, about $0.001 an image). Empty in production: avatars are saved
# as "not checked". Empty in dev: the fake runs.
# LIKENESS_AWS_ACCESS_KEY_ID=
# LIKENESS_AWS_SECRET_ACCESS_KEY=
# LIKENESS_AWS_REGION=eu-west-1

# Used by trend clustering (design.md §8.4).
# EMBEDDING_MODEL=text-embedding-3-small

# Force a port onto its fake (True) or off it (False), whatever its key says.
# USE_FAKE_TEXT_PROVIDER=False
# USE_FAKE_IMAGE_PROVIDER=False
# USE_FAKE_VIDEO_PROVIDER=False
# USE_FAKE_CHECKS_PROVIDER=False
# USE_FAKE_LIKENESS_PROVIDER=False
# True makes the fake look-alike check refuse every portrait (testing the refusal).
# FAKE_LIKENESS_MATCH=False
# True puts every AI port above on its fake at once.
# USE_FAKE_AI_PROVIDERS=False


# ═════════════════════════════════════════════════════════════════════════════
# TRENDS — corpus harvesting
# ═════════════════════════════════════════════════════════════════════════════
# Unset ⇒ USE_FAKE_TREND_VENDORS. Which vendor answers for a given source is a
# `TrendSource.vendor` row, so a dead vendor is a row edit rather than a deploy.
# TREND_VENDOR_BASE_URL=https://trends.p.rapidapi.com
# TREND_VENDOR_API_KEY=
# TREND_VENDOR_TIMEOUT_SECONDS=20
# YOUTUBE_API_KEY=
# REDDIT_USER_AGENT=occs-trends/1.0
# USE_FAKE_TREND_VENDORS=False

# ═════════════════════════════════════════════════════════════════════════════
# PLAYBOOK — trending public posts to compose from (`playbook/`)
# ═════════════════════════════════════════════════════════════════════════════
# Two free providers: YouTube (YOUTUBE_API_KEY, above) and Google Trends' public
# RSS (no key). Without a key the fake collector answers — but only where
# PLAYBOOK_SHOW_SAMPLE is on, and its rows are labelled samples. prod.py pins
# PLAYBOOK_SHOW_SAMPLE off. Sources and their cadence are rows (admin).
# PLAYBOOK_DEFAULT_REGION=TN
# PLAYBOOK_REGIONS=TN
# PLAYBOOK_SHOW_SAMPLE=False
# PLAYBOOK_SAMPLE_IMAGE_BASE=
# PLAYBOOK_COLLECTOR_TIMEOUT_SECONDS=15
# PLAYBOOK_USER_AGENT=composevision-playbook/1.0
# USE_FAKE_PLAYBOOK_COLLECTORS=False
# A reference's picture is read server-side, only from these hosts, never
# stored. Comma-separated; a leading dot allows subdomains.
# REFERENCE_IMAGE_HOSTS=i.ytimg.com,i9.ytimg.com,.ggpht.com
# REFERENCE_IMAGE_MAX_BYTES=5242880
# REFERENCE_IMAGE_TIMEOUT_SECONDS=10
# USE_FAKE_REFERENCE_IMAGES=False


# ═════════════════════════════════════════════════════════════════════════════
# PUBLISHING & MEASUREMENT — Zernio
# ═════════════════════════════════════════════════════════════════════════════
# One vendor, two structurally separate ports (BUILD-PLAN P0-28): publishing
# sends data out, measurement pulls it in, and neither carries the other's
# methods. One key today because it is one vendor today.
#
# Unset ⇒ USE_FAKE_PLATFORM_ADAPTER, which also selects the fake metrics
# provider. Rows it produces are stamped `source=FAKE` and excluded from every
# statistic by the queryset, so a fake can never become insight (P0-37).
# ZERNIO_BASE_URL=https://zernio.com/api
# ZERNIO_API_KEY=
# ZERNIO_TIMEOUT_SECONDS=30
# Blank = auto: the fakes until the provider chosen by SOCIAL_PROVIDER has its
# key and its adapters. True forces the fakes; False forces the real provider.
# USE_FAKE_PLATFORM_ADAPTER=

# HMAC secret for the `comment.received` webhook (P0-35). Empty means the
# endpoint refuses every delivery — the right default, since an unconfigured
# webhook that accepted anything would be an open write path into the audience
# tables. The capture *cadence* each plan gets is a plan row, not this.
# ZERNIO_WEBHOOK_SECRET=

# ═════════════════════════════════════════════════════════════════════════════
# SOCIALAPI.AI — primary social provider (social-provider-plan.md)
# ═════════════════════════════════════════════════════════════════════════════
# Key from app.social-api.ai → Keys (sapi_key_…), server-side only. The webhook
# secret is shown once when the endpoint is registered. SOCIAL_PROVIDER=zernio
# switches back to the alternative provider.
# SOCIAL_PROVIDER=socialapi
# SOCIALAPI_BASE_URL=https://api.social-api.ai/v1
# SOCIALAPI_API_KEY=
# SOCIALAPI_WEBHOOK_SECRET=
# SOCIALAPI_TIMEOUT_SECONDS=30
# The team-wide request budget before the first response reports the real one
# (X-RateLimit-Limit); 60/min is the Free plan. Background calls (capture,
# comments) never draw into the publish reserve.
# SOCIALAPI_REQUESTS_PER_MINUTE=60
# SOCIALAPI_PUBLISH_RESERVE_RATIO=0.4
# Share of successful reads written to the provider call log (writes and
# failures always are), and how long that log is kept.
# SOCIALAPI_READ_SAMPLE_RATE=0.1
# SOCIALAPI_CALL_RETENTION_DAYS=30
# How published media reaches the provider: url (a signed link to our storage)
# or upload (the bytes). Blank = auto: upload for local/private storage.
# SOCIALAPI_MEDIA_MODE=
# SOCIALAPI_MEDIA_URL_TTL_SECONDS=21600
# Webhooks (SA-40): the secret `manage.py socialapi_webhooks register` prints
# once; during a rotation the old one goes in _PREVIOUS until it is retired.
# Deliveries older than the tolerance are refused (replay protection).
# SOCIALAPI_WEBHOOK_SECRET_PREVIOUS=
# SOCIALAPI_WEBHOOK_TOLERANCE_SECONDS=300
# SOCIALAPI_WEBHOOK_RETENTION_DAYS=30


# ═════════════════════════════════════════════════════════════════════════════
# MEDIA EDITING — crop & trim (BUILD-PLAN P1-12)
# ═════════════════════════════════════════════════════════════════════════════
# Two ports, and they are deliberately asymmetric. Image editing runs on
# Pillow, already a dependency, so cropping needs no vendor and no key and is
# available in every deployment. Trimming needs a codec — a system dependency
# Part 7 rule 6 says a fresh checkout must not require — so it resolves to
# nothing until a backend is named here, and the service answers 422 rather
# than a fake quietly producing a clip nobody rendered.
#
# Neither editor mutates anything: an edit produces a NEW MediaAsset carrying
# `derived_from`, because the original is immutable by design.
# VIDEO_EDITOR_BACKEND=
# USE_FAKE_MEDIA_EDITOR=False

# ═════════════════════════════════════════════════════════════════════════════
# EMAIL
# ═════════════════════════════════════════════════════════════════════════════
# Verification codes, welcome, workspace invitations and the heads-up before a
# post goes live are all sent through this. Fill these to send real mail.
# Tests and the e2e run override the backend (memory / file), so they never
# reach a real server whatever is set here.
#
# To print mail to the terminal instead while developing, set
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@attractvision.com

# Minutes before its slot that a scheduled post's author gets the heads-up.
# POST_HEADS_UP_LEAD_MINUTES=120


# --- Error reporting (Sentry, common/observability.py) ------------------------
# Blank DSN = off. Web, Celery worker and beat all report when it is set.
# Check it with `manage.py sentry_check`.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production          # default: development when DEBUG, else production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=1.0          # share of requests traced (0–1)
# SENTRY_PROFILE_SESSION_SAMPLE_RATE=1.0 # share of sessions profiled (0–1)

# ═════════════════════════════════════════════════════════════════════════════
# PRODUCTION ONLY
# ═════════════════════════════════════════════════════════════════════════════
# Read by config/settings/prod.py. Harmless to leave unset in dev.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# --- Catalogue seed -----------------------------------------------------------
# `migrate` seeds plans, packs, currencies, categories, trend sources, tools,
# generation costs and the Studio's creative options (never overwriting an edit
# made in admin). Set False only to start from empty tables.
# SEED_CATALOG_ON_MIGRATE=True

# --- Brand import (steps-plan S1) ---------------------------------------------
# True serves fixture sites (brand/fixtures/sites/); False crawls real websites.
# USE_FAKE_SITE_FETCHER=True
